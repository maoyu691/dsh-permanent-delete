{
  "name": "dsh-permanent-delete",
  "version": "0.2.1",
  "description": "DeepSeek Harness plugin, CLI and sidebar action for permanently deleting JSONL-backed sessions.",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maoyu691/dsh-permanent-delete.git"
  },
  "homepage": "https://github.com/maoyu691/dsh-permanent-delete",
  "bugs": "https://github.com/maoyu691/dsh-permanent-delete/issues",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-delete-session": "./bin/dsh-delete-session.js"
  },
  "files": [
    "bin/",
    "lib/",
    "scripts/",
    "index.js",
    "client.js",
    "build.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "peerDependencies": {},
  "devDependencies": {}
}
